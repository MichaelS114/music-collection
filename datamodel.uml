@startuml
' Style
skinparam class {
    BackgroundColor Snow
    ArrowColor Black
    BorderColor Black
}
hide circle
hide methods

enum Role {
  ADMIN
  USER
}

enum Status {
  LIKE
  DISLIKE
  FAVOURITE
  NONE
}

enum MusicType {
  TRACK
  ALBUM
}

class User {
  Int id
  String username
  Role role
  DateTime created
}

class MusicItem {
  Int id
  String title
  String artist
  String album
  Int year
  String genre
  MusicType type
  Int createdBy
}

class UserMusicCollection {
  Int id
  Int userId
  Int musicId
  Status status
  DateTime addedAt
}

class Review {
  Int id
  Int userId
  Int musicId
  String comment
  Int rating
  DateTime createdAt
}

User "1" -- "many" MusicItem : "creates (CreatedMusic)"
User "1" -- "many" UserMusicCollection : "has"
User "1" -- "many" Review : "writes"

MusicItem "1" -- "many" UserMusicCollection : "is in"
MusicItem "1" -- "many" Review : "has reviews"

UserMusicCollection "1" --> "1" User : "userId"
UserMusicCollection "1" --> "1" MusicItem : "musicId"

Review "1" --> "1" User : "userId"
Review "1" --> "1" MusicItem : "musicId"

@enduml
